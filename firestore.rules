rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && userDoc().data.status != 'موقوف';
    }

    function isAdmin() {
      return activeUser() && userDoc().data.role == 'مدير';
    }

    function hasPermission(moduleKey, actionKey) {
      return isAdmin()
        || (activeUser()
          && userDoc().data.permissions[moduleKey][actionKey] == true);
    }

    // Account documents are server-managed through the Admin SDK. The client
    // may read its own profile (or profiles as an administrator), but cannot
    // create, update, or delete users documents.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'credentialVersion', 'securityVersion', 'lastPasswordChangeAt']));
      allow delete: if isAdmin();
    }

    match /username_index/{username} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Legacy account storage is not a client API.
    match /staff_accounts/{document} {
      allow read, write: if false;
    }

    // Recovery material is server-only through /api/admin/account.
    match /_security/{document} {
      allow read, write: if false;
    }

    match /system_control/{document} {
      allow read: if activeUser();
      allow write: if false;
    }

    // Clinical collections.
    match /visits_clinic/{document} {
      allow read, write: if activeUser();
    }
    match /visits_dental/{document} {
      allow read, write: if activeUser();
    }
    match /visits_operations/{document} {
      allow read, write: if activeUser();
    }
    match /visits_labs/{document} {
      allow read, write: if activeUser();
    }
    match /visits_radiology/{document} {
      allow read, write: if activeUser();
    }

    // Financial collections.
    match /income/{document} {
      allow read, write: if activeUser();
    }
    match /expense/{document} {
      allow read, write: if activeUser();
    }
    match /payroll/{document} {
      allow read, write: if activeUser();
    }
    match /lab_expenses/{document} {
      allow read, write: if activeUser();
    }

    // Operational records may be created as part of another business operation.
    match /appointments/{document} { allow read, write: if activeUser(); }
    match /payments/{document} { allow read, write: if activeUser(); }
    match /prescriptions/{document} { allow read, write: if activeUser(); }

    match /doctors/{document} {
      allow read: if hasPermission('doctors', 'view');
      allow create: if hasPermission('doctors', 'add');
      allow update: if hasPermission('doctors', 'edit');
      allow delete: if hasPermission('doctors', 'delete');
    }
    match /employees/{document} {
      allow read: if hasPermission('employees', 'view');
      allow create: if hasPermission('employees', 'add');
      allow update: if hasPermission('employees', 'edit');
      allow delete: if hasPermission('employees', 'delete');
    }

    // Configuration collections are readable by active users for form options;
    // only the matching module may write them.
    match /settings/{document=**} {
      allow read: if activeUser();
      allow write: if hasPermission('settings', 'edit');
    }
    match /categories/{document} {
      allow read: if activeUser();
      allow create: if hasPermission('categories', 'add');
      allow update: if hasPermission('categories', 'edit');
      allow delete: if hasPermission('categories', 'delete');
    }
    match /specialties/{document} {
      allow read: if activeUser();
      allow write: if hasPermission('doctors', 'edit') || hasPermission('settings', 'edit');
    }

    // Audit entries may be appended by active staff; only the administrator may
    // read or alter the audit trail.
    match /audit_log/{document} {
      allow read, update, delete: if isAdmin();
      allow create: if activeUser();
    }

    // No broad activeUser read/write fallback. Unknown collections are denied.
    match /{collection}/{document} {
      allow read, write: if false;
    }
  }
}
