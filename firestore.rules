rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == 'مدير' && userDoc().data.status != 'موقوف';
    }

    function activeUser() {
      return signedIn() && userDoc().data.status != 'موقوف';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'credentialVersion', 'securityVersion', 'lastPasswordChangeAt']));
      allow delete: if isAdmin();
    }

    match /username_index/{username} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // staff_accounts مخزن انتقالي قديم؛ لا يُستخدم من العميل ولا تُكتب إليه بيانات جديدة.
    match /staff_accounts/{document} {
      allow read, write: if false;
    }

    match /system_control/{document} {
      allow read: if activeUser();
      allow write: if false;
    }

    // Basic authenticated access for the first migration stage. Before enabling
    // production writes, tighten these rules per module and role.
    match /{collection}/{document} {
      allow read, write: if activeUser()
        && collection != 'users'
        && collection != 'username_index'
        && collection != 'settings'
        && collection != 'staff_accounts'
        && collection != 'system_control';
    }

    match /settings/{document=**} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
  }
}
