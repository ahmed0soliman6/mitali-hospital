{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/admin/account",
      "destination": "/api/admin/account.js"
    },
    {
      "source": "/api/admin/data",
      "destination": "/api/admin/data.js"
    },
    {
      "source": "/api/auth/profile",
      "destination": "/api/auth/profile.js"
    },
    {
      "source": "/api/financial/summary",
      "destination": "/api/financial/summary.js"
    },
    {
      "source": "/((?!api/|sw\\.js|manifest\\.webmanifest|manifest\\.json|firebase-store\\.js|icon.*|apple-touch.*|favicon.*).*)$",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
