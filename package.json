{
  "name": "mitali-hospital",
  "private": true,
  "version": "1.3.46",
  "description": "تطبيق سطح مكتب لإدارة مستشفى ميت على",
  "author": "Mitali Hospital",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node tools/check-js-syntax.js",
    "test:contracts": "node tools/api-contract-tests.js",
    "test:security": "node tools/security-auth-tests.js",
    "test:performance": "node tools/store-setvalue-performance-test.js",
    "test:account-delete": "node tools/account-api-delete-test.js",
    "test:data-wipe": "node tools/data-wipe-api-test.js",
    "test:income-form": "node tools/income-form-test.js",
    "test:ledger-visibility": "node tools/ledger-visibility-test.js",
    "test:doctor-payroll": "node tools/doctor-payroll-test.js",
    "test:accounting-consistency": "node tools/accounting-consistency-test.js",
    "test:doctor-departments": "node tools/doctor-departments-test.js",
    "test:dashboard-imaging": "node tools/dashboard-imaging-test.js",
    "test:dashboard-patient-sources": "node tools/dashboard-patient-sources-test.js",
    "test:settings-after-wipe": "node tools/settings-after-wipe-test.js",
    "test:account-permissions": "node tools/account-api-permissions-test.js",
    "test:permissions-refresh-race": "node tools/permissions-refresh-race-test.js",
    "test:permissions-transport": "node tools/permissions-transport-performance-test.js",
    "test:permissions-cache-runtime": "node tools/permissions-cache-runtime-test.js",
    "test:account-errors": "node tools/account-api-error-test.js",
    "test:read-reduction": "node tools/read-reduction-test.js",
    "test:unified-users-page": "node tools/unified-users-page-test.js",
    "test:sync-outbox": "node tools/sync-outbox-test.js",
    "test:sync-scenarios": "node tools/sync-scenarios-test.js",
    "test:sync-delete": "node tools/sync-delete-propagation-test.js",
    "test:snapshot-safety": "node tools/snapshot-safety-test.js",
    "test:ledger-visibility-runtime": "node tools/ledger-visibility-test.js",
    "test:ledger-visibility": "node tools/financial-ledger-runtime-test.js",
    "test:visit-income-reconciliation": "node tools/financial-ledger-runtime-test.js",
    "test:storage-mode-restore": "node tools/financial-ledger-runtime-test.js",
    "test": "npm run check && npm run test:contracts && npm run test:security && npm run test:performance && npm run test:account-delete && npm run test:data-wipe && npm run test:income-form && npm run test:ledger-visibility-runtime && npm run test:ledger-visibility && npm run test:visit-income-reconciliation && npm run test:storage-mode-restore && npm run test:doctor-payroll && npm run test:accounting-consistency && npm run test:doctor-departments && npm run test:dashboard-imaging && npm run test:dashboard-patient-sources && npm run test:settings-after-wipe && npm run test:account-permissions && npm run test:permissions-refresh-race && npm run test:permissions-transport && npm run test:permissions-cache-runtime && npm run test:account-errors && npm run test:read-reduction && npm run test:unified-users-page && npm run test:sync-outbox && npm run test:sync-scenarios && npm run test:sync-delete && npm run test:snapshot-safety",
    "desktop:start": "electron .",
    "desktop:dist": "electron-builder --win nsis --x64 --publish never",
    "desktop:publish": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "firebase-admin": "^13.5.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mitali.hospital",
    "productName": "Mitali Hospital",
    "artifactName": "Mitali-Hospital-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "firebase-store.js",
      "manifest.json",
      "manifest.webmanifest",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "apple-touch-icon.png",
      "favicon-32.png",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "ahmed0soliman6",
      "repo": "mitali-hospital-releases",
      "private": false,
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mitali Hospital"
    }
  }
}
